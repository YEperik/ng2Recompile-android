diff -ruN a/src/core/main_android.cpp b/src/core/main_android.cpp
--- a/src/core/main_android.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/core/main_android.cpp	2026-10-31 09:34:13.874385159 +0000
@@ -0,0 +1,45 @@
+/**
+ * @file        core/main_android.cpp
+ * @brief       Android process helpers and content-URI stubs
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <android/api-level.h>
+
+#include <string_view>
+
+#include <rex/filesystem.h>
+#include <rex/main_android.h>
+
+namespace rex {
+
+int GetAndroidApiLevel() {
+  static const int level = android_get_device_api_level();
+  return level;
+}
+
+}  // namespace rex
+
+namespace rex::filesystem {
+
+// content:// documents are not opened natively. The host app copies game data
+// into a real directory first (the runtime needs filesystem paths), so there is
+// nothing to resolve here. Defined so MappedMemory::OpenForAndroidContentUri
+// links; it reports failure and the caller falls back to a path.
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view /*uri*/, const char* /*mode*/) {
+  return -1;
+}
+
+}  // namespace rex::filesystem
+
+#endif  // REX_PLATFORM_ANDROID
